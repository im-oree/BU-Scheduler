# ─────────────────────────────────────────────────────────────
# BU Scheduler — frontend environment variables
#
# Copy this file to `.env.local` and fill in real values.
# Every variable MUST be prefixed with VITE_ to be exposed to
# the browser bundle by Vite. Never put server-side secrets here.
# ─────────────────────────────────────────────────────────────

# ── Firebase (REQUIRED) ──────────────────────────────────────
# Without at least VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID
# the app boots into a permanent "anonymous / guest" state and every
# Firestore read returns empty. Grab these from:
# Firebase console → Project settings → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=

# ── StudentHub / API (OPTIONAL) ──────────────────────────────
# Base URL of the hosted StudentHub backend. `/api` is appended
# automatically by src/lib/api.ts.
# Default: https://studenthub-backend-1w1n.onrender.com
VITE_STUDENTHUB_API=

# Fallback API base URL, also used as the target of the Vite dev
# server's `/api` proxy. Default: http://localhost:4000
VITE_API_BASE_URL=

# ── StudentHub OAuth2 / OIDC (OPTIONAL) ──────────────────────
# Only needed if you re-enable the redirect-based StudentHub SSO
# flow in src/lib/auth.ts. Each URL falls back to
# `${VITE_STUDENTHUB_API}/oauth/...` when left blank.
VITE_OAUTH_CLIENT_ID=bu-scheduler-dev
VITE_OAUTH_AUTHORIZE_URL=
VITE_OAUTH_TOKEN_URL=
VITE_OAUTH_USERINFO_URL=
VITE_OAUTH_JWKS_URL=
